{
  "name": "quik-sign",
  "short_name": "quik-sign",
  "description": "Sign PDFs with a pen. Nothing is uploaded",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#141415",
  "theme_color": "#0f0f10",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
